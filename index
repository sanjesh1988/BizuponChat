<script>
    /*-- change profile image --*/
    function readURL(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                $('#imagePreview').css('background-image', 'url('+e.target.result +')');
                $('#imagePreview').hide();
                $('#imagePreview').fadeIn(650);
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
    $("#imageUpload").change(function() {
        readURL(this);
    });

    /*-- page loading --*/
    $(window).on('load',function(){
        setTimeout(function(){ 
            $('#loader').fadeOut('slow');
        },1000);
    });

    /*-- profile show hide --*/
    $(document).ready(function(){
        $(".profile").click(function(){
            $(".user_profile_block").addClass('show');
            $(".sidebar").addClass('hide');
        });
        $(".bx-arrow-back").click(function(){
            $(".user_profile_block").addClass('hide');
            $(".user_profile_block").removeClass('show');
            $(".sidebar").addClass('show');
            $(".sidebar").removeClass('hide');
        });
    });


    /*-- Dealing with Textarea Height --*/
    const textarea = document.getElementById("textarea");

    function setHeight(elem) {
    const style = getComputedStyle(elem, null);
    const verticalBorders = Math.round(parseFloat(style.borderTopWidth) + parseFloat(style.borderBottomWidth));
    const maxHeight = parseFloat(style.maxHeight) || 200;
    
    elem.style.height = "auto";

    const newHeight = elem.scrollHeight + verticalBorders;
    
    elem.style.overflowY = newHeight > maxHeight ? "auto" : "hidden";
    elem.style.height = Math.min(newHeight, maxHeight) + "px";
    }

    textarea.addEventListener("input", (e) => {
    setHeight(e.target);
    });

    setHeight(textarea);
</script>

